{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telinha",
  "version": "1.0.0",
  "identifier": "app.telinha.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix .. run build:app",
    "frontendDist": "../../dist-app"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telinha",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "useHttpsScheme": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
