# Configuração do servidor do Telinha. O setup.sh (Linux) ou o
# windows\iniciar.ps1 (teste no Windows) cria o .env a partir deste modelo.
# O .env tem a chave secreta: NÃO vai pro git e não deve ser compartilhado.

# --- Endereço (DuckDNS) ---------------------------------------------------
# O site sempre se conecta por este endereço. Trocar de servidor = só
# atualizar o IP no DuckDNS (o contêiner duckdns faz isso sozinho).
DOMAIN=telinha.duckdns.org
DUCKDNS_SUBDOMAIN=telinha
DUCKDNS_TOKEN=cole-o-token-do-duckdns-aqui

# --- Chaves do LiveKit (geradas automaticamente) -------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Regras da sala --------------------------------------------------------
# Máximo de pessoas por sala.
MAX_PARTICIPANTS=6

# Qualidade máxima das telas: 720, 1080 ou 1440.
# Conta rápida: o servidor envia ~ (pessoas assistindo) × (qualidade):
#   720p ≈ 6 Mbps · 1080p ≈ 15 Mbps · 1440p ≈ 28 Mbps por pessoa
#   Ex.: 6 pessoas em 1080p ≈ 90 Mbps de upload; 10 em 1080p ≈ 150 Mbps.
MAX_QUALITY=1080

# Chat de voz: false = desligado (ninguém publica microfone, o site esconde
# tudo de voz). Pra religar: true e reiniciar o servidor de tokens.
VOICE_ENABLED=false
